{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run: app",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "args": ["app"],
      "envFile": "${workspaceFolder}/.env.app",
      "console": "integratedTerminal",
      "hideSystemGoroutines": true,
      "presentation": { "group": "1-run" }
    },
    {
      "name": "Run: bot",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "args": ["bot"],
      "envFile": "${workspaceFolder}/.env.bot",
      "console": "integratedTerminal",
      "hideSystemGoroutines": true,
      "presentation": { "group": "1-run" }
    },
    {
      "name": "Run: app (with race)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "args": ["app"],
      "envFile": "${workspaceFolder}/.env.app",
      "env": { "CGO_ENABLED": "1" },
      "buildFlags": "-race",
      "console": "integratedTerminal",
      "hideSystemGoroutines": true,
      "presentation": { "group": "2-race" }
    },
    {
      "name": "Run: bot (with race)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}",
      "args": ["bot"],
      "envFile": "${workspaceFolder}/.env.bot",
      "env": { "CGO_ENABLED": "1" },
      "buildFlags": "-race",
      "console": "integratedTerminal",
      "hideSystemGoroutines": true,
      "presentation": { "group": "2-race" }
    },
    {
      "name": "Tests: current package",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "envFile": "${workspaceFolder}/.env.app",
      "console": "integratedTerminal",
      "hideSystemGoroutines": true,
      "presentation": { "group": "3-debug" }
    },
    {
      "name": "Attach: local process",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickGoProcess}",
      "hideSystemGoroutines": true,
      "presentation": { "group": "3-debug" }
    }
  ],
  "compounds": [
    {
      "name": "Run: all",
      "configurations": ["Run: app", "Run: bot"],
      "stopAll": true,
      "presentation": { "group": "1-run" }
    },
    {
      "name": "Run: all (with race)",
      "configurations": ["Run: app (with race)", "Run: bot (with race)"],
      "stopAll": true,
      "presentation": { "group": "2-race" }
    }
  ]
}
